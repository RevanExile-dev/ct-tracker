# In produzione (Vercel) vanno impostate come variabili d'ambiente del
# progetto, MAI committate in questo file.

# Obbligatoria per l'intero sito, non solo per l'account: catalogo,
# prezzi, movers, binder/wishlist/filtri e login leggono tutti dallo
# stesso Postgres (vedi web/lib/db.server.ts, web/lib/pgPool.ts). Impostata
# automaticamente collegando un database Postgres al progetto Vercel
# (Storage -> Create Database) - stringa di connessione pooled.
POSTGRES_URL=postgres://...

# Genera con: npx auth secret (oppure una stringa casuale lunga a mano).
# Obbligatoria in produzione, altrimenti Auth.js si rifiuta di partire.
AUTH_SECRET=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth Client ID
# (tipo "Web application"). Redirect URI da autorizzare:
# https://<tuo-dominio>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# resend.com -> API Keys. Il livello gratuito basta per un sito hobby
# (100 email/giorno, 3000/mese).
AUTH_RESEND_KEY=
# Indirizzo mittente per l'email di accesso. Senza un dominio verificato su
# Resend, puoi lasciare il default "onboarding@resend.dev" (funziona subito,
# ma finisce piu' facilmente nello spam) - con un dominio tuo verificato,
# es. "CartaViva <accesso@tuodominio.it>".
AUTH_EMAIL_FROM=CartaViva <onboarding@resend.dev>

# Collegamento account<->Telegram (punto 4 del piano) e futuri allarmi
# prezzo - vedi web/app/api/telegram/webhook/route.ts. Stesso bot/token gia'
# usato dai secret GitHub Actions TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID per
# scripts/notify_telegram.py, ma qui va aggiunto ANCHE come variabile
# d'ambiente del progetto Vercel (le due cose sono impostazioni separate,
# un progetto GitHub Actions non condivide le variabili con Vercel).
TELEGRAM_BOT_TOKEN=
# Stringa casuale a scelta (es. `python -c "import secrets; print(secrets.token_hex(32))"`),
# deve combaciare esattamente con quella passata a
# scripts/telegram_set_webhook.py al momento di registrare il webhook.
TELEGRAM_WEBHOOK_SECRET=
# Facoltativa: nome utente pubblico del bot (senza @, es. "cartaviva_bot"),
# solo per mostrare un link diretto "Apri Telegram" nella pagina di
# collegamento - senza, l'utente puo' comunque cercare il bot a mano su
# Telegram e mandargli "/start <codice>".
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
