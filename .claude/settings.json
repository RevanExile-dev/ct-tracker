{
  "permissions": {
    "allow": [
      "mcp__github__actions_list",
      "mcp__github__pull_request_read",
      "mcp__github__actions_get",
      "mcp__github__get_job_logs",
      "mcp__github__list_pull_requests",
      "mcp__github__issue_read"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-push-sync-check.sh",
            "if": "Bash(git push*)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/web-lint-fix.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/python-syntax-check.sh"
          }
        ]
      }
    ]
  }
}
