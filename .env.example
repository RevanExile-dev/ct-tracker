# Serve SOLO se vuoi lanciare gli script Python sul tuo computer per test.
# Per il funzionamento normale (GitHub Actions) token e connection string
# vanno inseriti come Secret del repository, MAI in questo file committato.
# Nota: gli script leggono le variabili d'ambiente vere e proprie (os.environ),
# non questo file direttamente - esportale nella shell (es. `export $(cat .env | xargs)`
# o il meccanismo equivalente del tuo terminale) prima di lanciarli.
CARDTRADER_API_TOKEN=il_tuo_token_qui

# Stesso Postgres usato da web/ (vedi web/.env.example) - senza questa
# variabile scripts/db.py esce subito con un errore.
POSTGRES_URL=postgres://...
